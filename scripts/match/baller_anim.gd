class_name BallerAnim
## Turns sheets that follow the BallerSheet contract into playable animations.
## BallerSheet is GENERATED by the chibi rig bake (tools/chibi_rig/bake.py)
## together with the sheets themselves, so layout, timing and ball anchors
## can never drift from the art. This is the ONLY place frame regions are
## computed. See docs/ASSET_PIPELINE.md.


static func build_frames(sheet_path: String) -> SpriteFrames:
	## Every animation in BallerSheet.ANIMS, cut from one character sheet.
	## Loops play at their fps; one-shots (fps 0) are scrubbed by BallerVisual.
	var tex: Texture2D = Art.tex(sheet_path)
	var size: Vector2i = BallerSheet.FRAME_SIZE
	var frames := SpriteFrames.new()
	frames.remove_animation("default")
	for anim_name in BallerSheet.ANIMS:
		var anim: Dictionary = BallerSheet.ANIMS[anim_name]
		var fps: float = anim["fps"]
		var row: int = anim["row"]
		var times: Array = anim["times"]
		frames.add_animation(anim_name)
		frames.set_animation_speed(anim_name, fps if fps > 0.0 else 1.0)
		frames.set_animation_loop(anim_name, fps > 0.0)
		for f in times.size():
			var at := AtlasTexture.new()
			at.atlas = tex
			at.region = Rect2(f * size.x, row * size.y, size.x, size.y)
			frames.add_frame(anim_name, at)
	return frames


static func frame_at(anim_name: String, t: float) -> int:
	## The frame of a one-shot whose move time is closest to t (0..1).
	var anim: Dictionary = BallerSheet.ANIMS[anim_name]
	var times: Array = anim["times"]
	var best := 0
	var best_d := INF
	for i in times.size():
		var d: float = absf(float(times[i]) - t)
		if d < best_d:
			best_d = d
			best = i
	return best


static func mark(anim_name: String) -> float:
	## The move time the game syncs to (shot release, dunk slam).
	var anim: Dictionary = BallerSheet.ANIMS[anim_name]
	var t: float = anim["mark"]
	return t


static func ball_offset(anim_name: String, frame: int) -> Variant:
	## Ball center in that frame as an offset from the feet (facing right),
	## or null when the ball isn't in her hand.
	if not BallerSheet.ANIMS.has(anim_name):
		return null
	var anim: Dictionary = BallerSheet.ANIMS[anim_name]
	var balls: Array = anim["ball"]
	if frame < 0 or frame >= balls.size():
		return null
	return balls[frame]


static func build_simple_strip(sheet_path: String, frame_w: int, fps: float) -> SpriteFrames:
	## For single-row FX strips (ball spin, fire aura). frame_w 0 = square frames.
	var tex: Texture2D = Art.tex(sheet_path)
	var frames := SpriteFrames.new()
	frames.remove_animation("default")
	frames.add_animation("loop")
	frames.set_animation_speed("loop", fps)
	frames.set_animation_loop("loop", true)
	var h := tex.get_height()
	var w: int = frame_w if frame_w > 0 else h
	for f in int(tex.get_width() / float(w)):
		var at := AtlasTexture.new()
		at.atlas = tex
		at.region = Rect2(f * w, 0, w, h)
		frames.add_frame("loop", at)
	return frames
